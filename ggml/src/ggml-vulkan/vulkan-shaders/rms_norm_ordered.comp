#version 450

// RMS_NORM of one row (one token), summed in the order of upstream's ADD + RMS_NORM fusion (add.comp with ADD_RMS,
// then rms_norm_partials.comp), so that a norm gives the same bits whether or not an ADD hands it partial sums:
// which ADDs come right before a norm then no longer changes the result (fusions, shared nodes, the graph's order).
//
//   partial k: elements 512k .. 512k+511, thread t of 256 squaring t and t+256 (add.comp's loop), a subgroupAdd and
//              the tree over the subgroups (add.comp's reduction);
//   the sum:   each subgroup lane adding partials lane, lane + subgroup size, ..., then a subgroupAdd
//              (rms_norm_partials.comp);
//   the write: rms_norm_partials.comp's, with [* weight [+ residual [* post scale]]].
//
// Each step is written as the shader it mirrors writes it. If those shaders change, test-vulkan-norm-order fails;
// GGML_VK_DISABLE_ORDERED_RMS_NORM=1 returns to upstream's plain norm. Fork file, not upstream's.

#include "generic_binary_head.glsl"
#include "types.glsl"

#extension GL_EXT_control_flow_attributes : enable
#extension GL_KHR_shader_subgroup_arithmetic : enable
#extension GL_KHR_shader_subgroup_basic : enable

layout (constant_id = 1) const bool do_multiply = false;
#if RMS_NORM_ADD_FUSION
layout (constant_id = 2) const bool do_post_multiply = false;
layout (binding = 3) readonly buffer C {float data_c[];};
layout (binding = 4) readonly buffer E {float data_e[];};
#endif

// add.comp's workgroup: 256 threads, two elements each, a partial for every 512 elements
const uint num_threads = 256;
const uint num_iter = 2;
// rows up to 512*MAX_PARTIALS elements, subgroups of at least 256/MAX_SUBGROUPS lanes (the host checks both)
const uint MAX_PARTIALS = 64;
const uint MAX_SUBGROUPS = 32;

layout(local_size_x = num_threads, local_size_y = 1, local_size_z = 1) in;

shared FLOAT_TYPE sumsh[MAX_PARTIALS * MAX_SUBGROUPS];

void main() {
    const uint ncols = p.ne00;
    const uint tid   = gl_LocalInvocationID.x;
    const uint sg    = gl_SubgroupID;
    const uint lane  = gl_SubgroupInvocationID;
    const uint NumSubgroups = num_threads / gl_SubgroupSize;
    const uint num_partials = (ncols + num_iter * num_threads - 1) / (num_iter * num_threads);

    const uint32_t a_offset = get_aoffset();
    const uint32_t b_offset = src1_idx(0, 0, 0, 0) + get_boffset();
    const uint32_t d_offset = get_doffset();

    // the partials: add.comp's loop and subgroupAdd for each block of 512
    for (uint k = 0; k < num_partials; ++k) {
        uint idx = k * num_iter * num_threads + tid;
        FLOAT_TYPE sum_sq = 0;
        [[unroll]] for (uint i = 0; i < num_iter; ++i) {
            if (idx >= ncols) {
                continue;
            }
            FLOAT_TYPE sum = FLOAT_TYPE(data_a[a_offset + idx]);
            sum_sq += sum*sum;
            idx += num_threads;
        }
        sum_sq = subgroupAdd(sum_sq);
        if (lane == 0) {
            sumsh[k * MAX_SUBGROUPS + sg] = sum_sq;
        }
    }
    barrier();
    // add.comp's tree over the subgroups, for every block at once
    [[unroll]] for (uint s = NumSubgroups / 2; s > 0; s >>= 1) {
        if (sg < s && lane == 0) {
            for (uint k = 0; k < num_partials; ++k) {
                FLOAT_TYPE sum_sq = sumsh[k * MAX_SUBGROUPS + sg];
                sum_sq += sumsh[k * MAX_SUBGROUPS + sg + s];
                sumsh[k * MAX_SUBGROUPS + sg] = sum_sq;
            }
        }
        barrier();
    }

    // rms_norm_partials.comp's sum of the partials
    FLOAT_TYPE sum = FLOAT_TYPE(0.0f);
    for (uint32_t i = lane; i < num_partials; i += gl_SubgroupSize) {
        sum += sumsh[i * MAX_SUBGROUPS];
    }
    sum = subgroupAdd(sum);

    const FLOAT_TYPE mean = sum / FLOAT_TYPE(ncols);
    const FLOAT_TYPE scale = inversesqrt(mean + FLOAT_TYPE(p.param1));

    // rms_norm_partials.comp's write, a column a thread there, here strided over the row
    for (uint col = tid; col < ncols; col += num_threads) {
        if (do_multiply) {
            if (ncols > p.ne10) {
                FLOAT_TYPE value = scale * FLOAT_TYPE(data_a[a_offset + col]) * FLOAT_TYPE(data_b[b_offset + fastmod(col, p.ne10)]);
#if RMS_NORM_ADD_FUSION
                value += FLOAT_TYPE(data_c[d_offset + col]);
                if (do_post_multiply) {
                    value *= FLOAT_TYPE(data_e[0]);
                }
#endif
                data_d[d_offset + col] = D_TYPE(value);
            } else {
                FLOAT_TYPE value = scale * FLOAT_TYPE(data_a[a_offset + col]) * FLOAT_TYPE(data_b[b_offset + col]);
#if RMS_NORM_ADD_FUSION
                value += FLOAT_TYPE(data_c[d_offset + col]);
                if (do_post_multiply) {
                    value *= FLOAT_TYPE(data_e[0]);
                }
#endif
                data_d[d_offset + col] = D_TYPE(value);
            }
        } else {
            data_d[d_offset + col] = D_TYPE(scale * FLOAT_TYPE(data_a[a_offset + col]));
        }
    }
}
